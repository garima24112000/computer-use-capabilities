{
  "app": {
    "product": "meridian-core",
    "product_versions": ">=4.2,<5",
    "profile": "meridian-core",
    "surface": "web"
  },
  "description": "Looks up a member by member number and returns the balance of the base Share Savings account (suffix 00). HAND-WRITTEN TEST FIXTURE: real artifacts come from discovery.",
  "id": "meridian.member.read_savings_balance",
  "inputs": [
    {
      "description": "5-digit member number",
      "example": "12345",
      "name": "member_id",
      "pattern": "^\\d{5}$",
      "required": true,
      "sensitive": false,
      "type": "string"
    }
  ],
  "outcomes": [],
  "outputs": [
    {
      "description": "Balance of the Share Savings account (suffix 00) as a decimal string, e.g. 12345.67",
      "name": "savings_balance",
      "normalize": "money_to_decimal",
      "nullable": false,
      "sensitive": false,
      "type": "money"
    }
  ],
  "preconditions": {
    "entry_path": "/login",
    "session": "login_subflow"
  },
  "provenance": {
    "goal_redacted": "Read the share savings balance for a member",
    "recorder_version": "hand-written",
    "source": "hand_written"
  },
  "review": {},
  "schema_version": "1.0",
  "secrets": [],
  "status": "draft",
  "steps": [
    {
      "action": {
        "target": {
          "description": "MEMBER INQUIRY menu item",
          "frame": {
            "name_path": [
              "nav"
            ]
          },
          "strategies": [
            {
              "exact": true,
              "kind": "role_name",
              "name": "MEMBER INQUIRY",
              "role": "button"
            },
            {
              "exact": true,
              "kind": "text_match",
              "text": "MEMBER INQUIRY"
            }
          ]
        },
        "type": "click"
      },
      "approved": false,
      "expect": {
        "all_of": [
          {
            "frame": {
              "name_path": [
                "main"
              ]
            },
            "kind": "url_matches",
            "path_glob": "/inquiry*"
          }
        ],
        "description": "inquiry screen loaded",
        "timeout_ms": 5000
      },
      "id": "s01_open_member_inquiry",
      "intent": "Open the member inquiry screen from the left menu.",
      "requires_approval": false,
      "retry": {
        "backoff_ms": 500,
        "max_attempts": 1,
        "on": [
          "settle_timeout"
        ]
      },
      "risk": "risky",
      "settle_timeout_ms": 15000
    },
    {
      "action": {
        "target": {
          "description": "MEMBER NO. field",
          "frame": {
            "name_path": [
              "main"
            ]
          },
          "strategies": [
            {
              "kind": "label_anchor",
              "label": "MEMBER NO.",
              "role": "textbox"
            },
            {
              "exact": true,
              "kind": "role_name",
              "name": "MEMBER NO.",
              "role": "textbox"
            }
          ]
        },
        "type": "fill",
        "value": "{{inputs.member_id}}"
      },
      "approved": false,
      "id": "s02_fill_member_no",
      "intent": "Type the member number into the MEMBER NO. field.",
      "requires_approval": false,
      "retry": {
        "backoff_ms": 500,
        "max_attempts": 1,
        "on": [
          "settle_timeout"
        ]
      },
      "risk": "safe",
      "settle_timeout_ms": 15000
    },
    {
      "action": {
        "target": {
          "description": "INQUIRE button",
          "frame": {
            "name_path": [
              "main"
            ]
          },
          "strategies": [
            {
              "exact": true,
              "kind": "role_name",
              "name": "INQUIRE",
              "role": "link"
            },
            {
              "exact": true,
              "kind": "text_match",
