      {
        "exact": false,
        "frame": {
          "name_path": [
            "main"
          ]
        },
        "kind": "text_present",
        "text": "MEMBER DETAIL - {{inputs.member_id}}"
      },
      {
        "exact": false,
        "frame": {
          "name_path": [
            "main"
          ]
        },
        "kind": "text_present",
        "text": "ACCOUNTS"
      }
