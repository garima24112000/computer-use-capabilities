              "description": "NAME link in the result row for the member",
              "frame": {
                "name_path": [
                  "main"
                ]
              },
              "strategies": [
                {
                  "column_header": "NAME",
                  "kind": "table_cell",
                  "row_key": "{{inputs.member_id}}"
                }
              ]
            }
          }
        ],
        "description": "result row for the member is listed",
        "timeout_ms": 5000
      },
      "id": "s03_click_inquire",
      "intent": "Run the inquiry; either the result row appears or the core answers with a business outcome.",
      "requires_approval": false,
      "retry": {
        "backoff_ms": 500,
        "max_attempts": 1,
        "on": [
          "settle_timeout"
        ]
      },
      "risk": "risky",
      "settle_timeout_ms": 15000
    },
    {
      "action": {
        "target": {
          "description": "NAME link in the result row for the member",
          "frame": {
            "name_path": [
              "main"
            ]
          },
          "strategies": [
            {
              "column_header": "NAME",
              "kind": "table_cell",
              "row_key": "{{inputs.member_id}}"
            }
          ]
        },
        "type": "click"
      },
      "approved": false,
      "expect": {
        "all_of": [
          {
            "frame": {
              "name_path": [
                "main"
              ]
            },
            "kind": "url_matches",
            "path_glob": "/member/detail*"
          },
          {
            "exact": false,
            "frame": {
              "name_path": [
                "main"
              ]
            },
            "kind": "text_present",
            "text": "MEMBER DETAIL - {{inputs.member_id}}"
          }
        ],
        "description": "member detail page for the member",
        "timeout_ms": 5000
      },
      "id": "s04_open_member_detail",
      "intent": "Open the member detail page via the name link in the result row keyed by the member number.",
      "notes": "The row is keyed by the member number (a declared, non-sensitive input), never by the member's name, which is PII.",
      "requires_approval": false,
      "retry": {
        "backoff_ms": 500,
        "max_attempts": 1,
        "on": [
          "settle_timeout"
        ]
      },
      "risk": "risky",
      "settle_timeout_ms": 15000
    },
    {
      "action": {
        "output": "savings_balance",
        "target": {
          "description": "Share Savings BALANCE cell in ACCOUNTS",
          "frame": {
            "name_path": [
              "main"
            ]
          },
          "strategies": [
            {
              "column_header": "BALANCE",
              "kind": "table_cell",
              "row_key": "Share Savings",
              "section_header": "ACCOUNTS"
            },
            {
              "column_header": "BALANCE",
              "kind": "table_cell",
              "row_key": "00",
              "section_header": "ACCOUNTS"
            }
          ]
        },
        "type": "extract"
      },
      "approved": false,
      "id": "s05_extract_savings_balance",
      "intent": "Read the BALANCE of the Share Savings row in the ACCOUNTS table.",
      "notes": "Fallback keys on suffix 00: if a second Share Savings sub-account exists, the first strategy is ambiguous and resolution falls through to the base account (reported as degraded).",
      "requires_approval": false,
      "retry": {
        "backoff_ms": 500,
        "max_attempts": 1,
        "on": [
          "settle_timeout"
        ]
      },
      "risk": "safe",
      "settle_timeout_ms": 15000
    }
  ],
  "success": {
    "all_of": [
      {
        "frame": {
          "name_path": [
            "main"
          ]
        },
        "kind": "url_matches",
        "path_glob": "/member/detail*"
