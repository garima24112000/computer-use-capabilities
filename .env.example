# Copy to .env (gitignored). AWS credentials come from the named AWS profile, never from this file.
LLM_PROVIDER=bedrock
AWS_PROFILE=cua
AWS_REGION=us-east-1
# Bedrock inference profile id, e.g. us.anthropic.claude-...
BEDROCK_MODEL_ID=<inference profile id>

# Target app operator sign-on. FAKE demo credentials for the mock bank only.
BANK_OPERATOR_USER=demo_operator
BANK_OPERATOR_PASS=demo-pass-123
# SESSION_TTL_SECONDS=900
